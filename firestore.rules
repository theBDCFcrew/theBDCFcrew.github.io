rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin Allowlist ──
    // Allows authenticated users to verify if their UID or Email is in the admins collection.
    // Writes are blocked from the client (manage admins via Firebase Console).
    match /admins/{docId} {
      allow read: if request.auth != null && (request.auth.uid == docId || request.auth.token.email == docId);
      allow write: if false;
    }

    // ── Site View Counter ──
    // Allows public read & atomic increment for total page views.
    match /stats/{doc} {
      allow read, write: if true;
    }

    // ── Live Visitor Sessions ──
    // Allows public read, heartbeat updates, and session creation/deletion for active presence.
    match /sessions/{sessionId} {
      allow read, write: if true;
    }
  }
}
