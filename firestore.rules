rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──
    function isCommander() {
      return request.auth != null && (
        request.auth.uid == 'tT6YYY5VfuaK4jqlFuVPpWVyfY02' ||
        request.auth.token.email == 'briandivacox@gmail.com'
      );
    }

    function isOfficer() {
      return request.auth != null && (
        isCommander() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ── Admin Allowlist ──
    match /admins/{docId} {
      allow read: if request.auth != null;
      allow write: if isCommander();
    }

    // ── Live GTA Online Weekly Update Hub ──
    // Public read so all visitors across Portal & Los Santos Weekly see updates live.
    // Commander & authorized Officers can write/publish.
    match /weekly/{docId} {
      allow read: if true;
      allow write: if isOfficer();
    }

    // ── Historical Archive of Weekly Updates ──
    match /weekly_history/{docId} {
      allow read: if true;
      allow write: if isOfficer();
    }

    // ── Syndicate Crew Foundation: Roster, Events & Recruitment ──
    match /crew_members/{memberId} {
      allow read: if true;
      allow write: if isOfficer();
    }

    match /crew_events/{eventId} {
      allow read: if true;
      allow write: if isOfficer();
    }

    match /crew_applications/{appId} {
      allow create: if true;
      allow read, update, delete: if isOfficer();
    }

    // ── Site View Counter & Live Presence ──
    match /stats/{doc} {
      allow read, write: if true;
    }

    match /sessions/{sessionId} {
      allow read, write: if true;
    }
  }
}


