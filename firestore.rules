rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isCommander() {
      return request.auth != null && (
        request.auth.uid == 'tT6YYY5VfuaK4jqlFuVPpWVyfY02' ||
        request.auth.token.email == 'briandivacox@gmail.com'
      );
    }

    function isOfficer() {
      return request.auth != null && (
        isCommander() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default deny everything not explicitly matched
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Admin Allowlist (Commander only write) ──
    match /admins/{docId} {
      allow read: if request.auth != null;
      allow write: if isCommander();
    }

    // ── Live Weekly Updates & Archives (Read-only for public, Write only for Officers) ──
    match /weekly/{docId} {
      allow read: if true;
      allow write: if isOfficer();
    }

    match /weekly_history/{docId} {
      allow read: if true;
      allow write: if isOfficer();
    }

    // ── Crew Data (Read-only for public, Write only for Officers) ──
    match /crew_members/{memberId} {
      allow read: if true;
      allow write: if isOfficer();
    }

    match /crew_events/{eventId} {
      allow read: if true;
      allow write: if isOfficer();
    }

    // ── Applications (Public can ONLY create a new submission, cannot read or edit others) ──
    match /crew_applications/{appId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'platform', 'gamertag', 'submittedAt']);
      allow read, update, delete: if isOfficer();
    }

    // ── Stats (Atomic increment only for views) ──
    match /stats/{doc} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalViews']);
      allow create, delete: if isCommander();
    }

    // ── Sessions (Presence only) ──
    match /sessions/{sessionId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['active', 'lastSeen']);
      allow delete: if true;
    }
  }
}
